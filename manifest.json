{
  "manifest_version": 3,
  "name": "食べログ 除外キーワードフィルタ",
  "version": "1.1.0",
  "description": "食べログの検索結果から、店名またはジャンルに指定キーワードを含む店舗を除外します。",
  "permissions": ["storage"],
  "host_permissions": ["https://tabelog.com/*"],
  "content_scripts": [
    {
      "matches": ["https://tabelog.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
